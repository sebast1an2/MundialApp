# ══════════════════════════════════════════════════════════════════════════════
# MundialApp — Variables de entorno requeridas
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" en tu entorno local (NUNCA lo subas a git).
#   2. En Render: Dashboard → tu servicio → Environment → Add Environment Variable.
#   3. En Supabase: la DATABASE_URL está en Settings → Database → Connection string.
#
# TODAS las variables marcadas con [OBLIGATORIA] deben estar definidas
# o la aplicación no arrancará.
# ══════════════════════════════════════════════════════════════════════════════


# ── SEGURIDAD DE SESIÓN ────────────────────────────────────────────────────────
# [OBLIGATORIA] Clave secreta para firmar las cookies de sesión de Flask.
# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=reemplaza_con_una_clave_aleatoria_de_64_caracteres


# ── BASE DE DATOS ──────────────────────────────────────────────────────────────
# [OBLIGATORIA] URL de conexión a PostgreSQL.
# Render la provee automáticamente al crear una base de datos PostgreSQL.
# Supabase: Settings → Database → Connection string → URI (modo "Transaction" o "Session").
#
# Formatos aceptados (todos se normalizan a postgresql+psycopg:// internamente):
#   postgres://user:password@host:port/dbname          ← Render (formato legado)
#   postgresql://user:password@host:port/dbname        ← estándar
#   postgresql+psycopg://user:password@host:port/dbname ← psycopg3 directo
DATABASE_URL=postgresql+psycopg://usuario:contraseña@host:5432/nombre_base_de_datos


# ── PANEL ADMINISTRADOR ────────────────────────────────────────────────────────
# [OBLIGATORIA] Usuario del panel /admin/login
ADMIN_USERNAME=nombre_de_usuario_admin

# [OBLIGATORIA] Contraseña del panel /admin/login
# Usa una contraseña fuerte: mínimo 12 caracteres, mayúsculas, números y símbolos.
ADMIN_PASSWORD=contraseña_segura_aquí
